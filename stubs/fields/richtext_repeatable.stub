<div class="col-span-full">
    <label class="block text-sm/6 font-medium text-gray-900">{{ label }}</label>
    @php
    $fieldPath = "{{ errorMsg }}"; // build once
    $safeId = 'editor_' . str_replace('.', '_', $fieldPath);
    @endphp
    <div class="mt-2" wire:ignore x-data x-init="
        {{ $safeId }} = new window.Editor({
            el: document.querySelector('#{{ $safeId }}'),
            height: '300px',
            initialEditType: 'wysiwyg',
            previewStyle: 'vertical',
            toolbarItems: [
                ['heading', 'bold', 'italic'],
                ['hr', 'quote'],
                ['ul', 'ol', 'task'],
                ['table'],
                ['link'],
                ['code', 'codeblock']
            ]
        });

        {{ $safeId }}.on('change', () => {
            $wire.set('{{ $fieldPath }}', {{ $safeId }}.getHTML());
        });
    ">
        <div id="{{ $safeId }}">{!! {{ currentItemVariable }}['{{ subfieldName }}'] !!}</div>
    </div>
    @if ($errors->has("{{ errorMsg }}"))
        <span class="text-red-500 text-sm">{{ $errors->first("{{ errorMsg }}") }}</span>
    @endif
</div>
