                                        <div class="col-span-full">
                                            <h3 class="text-xl font-bold text-gray-800 mb-2">{{ field }}
                                            </h3>

                                            @foreach (${{ field }} as $index => $item)
                                                <div class="grid grid-cols-6 gap-4 mb-4 items-center">

                                                    {{ subfields }}



                                                    <!-- Remove Button -->
                                                    <div class="col-span-full flex justify-end items-center">
                                                        <button type="button"
                                                            wire:click="remove{{ field }}('{{ $item['uuid'] }}')"
                                                            class="mt-2 rounded-md bg-red-700 px-3 py-2 text-sm text-white hover:bg-red-800">
                                                            <span wire:loading.remove wire:target="remove{{ field }}('{{ $item['uuid'] }}')" >Delete</span>
                                                                <svg wire:loading wire:target="remove{{ field }}('{{ $item['uuid'] }}')"
                                                                    class="w-4 h-4 animate-spin text-white inline-block" fill="none"
                                                                    viewBox="0 0 24 24">
                                                                    <circle class="opacity-25" cx="12" cy="12" r="10"
                                                                        stroke="currentColor" stroke-width="4"></circle>
                                                                    <path class="opacity-75" fill="currentColor"
                                                                        d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                                                                </svg>
                                                            </button>
                                                    </div>
                                                </div>
                                            @endforeach

                                            <!-- Add Feature Button -->
                                            <div class="col-span-full flex justify-end items-center">
                                                <button type="button" wire:click="add{{ field }}"
                                                    class="mt-2 rounded-md bg-gray-800 px-3 py-2 text-sm text-white hover:bg-black">
                                                    <span wire:loading.remove wire:target="add{{ field }}" >+ Add {{ field }}</span>
                                                    <svg wire:loading wire:target="add{{ field }}"
                                                        class="w-4 h-4 animate-spin text-white inline-block" fill="none"
                                                        viewBox="0 0 24 24">
                                                        <circle class="opacity-25" cx="12" cy="12" r="10"
                                                            stroke="currentColor" stroke-width="4"></circle>
                                                        <path class="opacity-75" fill="currentColor"
                                                            d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                                                    </svg>
                                                </button>
                                            </div>


                                            @if ($errors->has("{{ errorMsg }}"))
