<?php

namespace {{ namespace }};

use Livewire\Component;
use App\Models\{{ model }};
use Livewire\WithFileUploads;
use Livewire\Attributes\Layout;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Str;

#[Layout('components.layouts.app')]
class {{ class }} extends Component
{
    use WithFileUploads;

    public ?{{ model }} $var{{ model }} = null;

    {{ fieldsBlock }}


    public function mount(){

        $this->var{{ model }} = {{ model }}::first();

        if($this->var{{ model }}){

         {{ mountBlock }}

        }

    }

    {{ jsonMethodsBlock }}

    

    public function save()
    {
        $this->validate({{ model }}::rules($this->var{{ model }}->id ?? null, $this));

        try {
            // create or update
            $record = $this->var{{ model }} ?? new {{ model }};

            {{ saveBlock }}

            $record->save();
            $this->var{{ model }} = $record; // keep in sync

            $this->dispatch(
                'toast',
                type: 'success',
                message: $record->wasRecentlyCreated ? 'Created!' : 'Updated!'
            );
        } catch (\Exception $e) {
            $this->dispatch('toast', type: 'error', message: 'Error: '.$e->getMessage());
        }
    }


    public function render()
    {
        return view('livewire.Crud.single.{{ viewName }}');
    }

}
