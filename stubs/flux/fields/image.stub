<div class="flex flex-col gap-2">
    <flux:input type="file" wire:model="{{ field }}" label="{{ label }}" accept="image/*" />

    @if (${{ field }} instanceof \Livewire\Features\SupportFileUploads\TemporaryUploadedFile && ${{ field }}->isPreviewable())
        <img src="{{ ${{ field }}->temporaryUrl() }}" alt="" class="size-24 rounded-lg object-cover">
    @elseif (${{ field }}Show)
        <img src="{{ Storage::disk('public')->url(${{ field }}Show) }}" alt="" class="size-24 rounded-lg object-cover">
    @endif
</div>
