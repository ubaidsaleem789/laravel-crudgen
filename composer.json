{
    "name": "ubaidsaleem/laravel-crudgen",
    "description": "Generate Livewire 4 CRUD pages from a model's fields() definition",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "UbaidCrudGen\\LaravelCrudGen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UbaidCrudGen\\LaravelCrudGen\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "symfony/html-sanitizer": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "UbaidCrudGen\\LaravelCrudGen\\LaravelCrudGenServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
