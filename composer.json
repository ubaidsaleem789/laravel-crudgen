{
    "name": "ubaidcrudgen/laravel-crudgen",
    "description": "Auto CRUD generator for Laravel using migrations & Livewire",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "UbaidCrudGen\\LaravelCrudGen\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^12.0",
        "doctrine/dbal": "^3.0",
        "livewire/livewire": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "UbaidCrudGen\\LaravelCrudGen\\LaravelCrudGenServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan crudgen:install-assets"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
